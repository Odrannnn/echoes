# IDE folders
.idea/
.vs/
.vscode/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
# ...but the port's own build files are not "miscellaneous": the decomp's rule
# above also matches CMakeLists.txt, which the port needs tracked.
!/CMakeLists.txt
*.exe
